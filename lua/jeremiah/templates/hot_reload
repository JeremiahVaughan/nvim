2. An example of usage
File Structure example for UI files:
   templates                                                             
   ├── base                                                              
   │ ├── index.html                                                      
   │ ├── layout.html                                                     
   │ ├── header.html                                                     
   │ └── footer.html                                                     
   └── overrides                                                         
       ├── index.html                                                    
       ├── layout.html                                                   
       ├── header.html                                                   
       └── footer.html                                                   
Init code:
    ```
    templates := []ui_util.HtmlTemplate{
        {
            Name: "base",
        },
    }
    err = ui_util.InitTemplateLoader(
        "templates/base",
        "templates/overrides",
        templates,
        localMode,
    )
    if err != nil {
        log.Fatalf("error, when initializing template loader. Error: %v", err)
    }
    ```
Reference the template loader after init via: ui_util.Tl
```
3. UI code:
```
    {{ if .LocalMode }}
    <script>
        const hotReloadPath = `/hotreload`
        console.log(`Hot reload initializing @ ${hotReloadPath}`)
        if (typeof(EventSource) !== "undefined") {
          const es = new EventSource(hotReloadPath);
          es.onmessage = function(event) {
            console.log("code change detected, reloading. Event:", event);                                              
            location.reload();
          }
          es.onerror = function(err) {
            console.log("lost connection to server, reloading");
            setTimeout(() => {
              location.reload();
            }, 500);
          };
          console.log("Hot reload initialized");                                              
        }
    </script>
    {{ end }}
```

