{
  "$schema": "https://charm.land/crush.json",
  "providers": {
    "ollama-private": {
      "name": "Private Ollama",
      "type": "openai-compat",
      "base_url": "http://192.168.1.173:11434/v1/",
      "models": [
        {
          "id": "gemma4:26b",
          "name": "gemma4:26b",
          "context_window": 256000,
          "default_max_tokens": 8192
        },
        {
          "id": "gemma4:e4b",
          "name": "gemma4:e4b",
          "context_window": 128000,
          "default_max_tokens": 4096
        }
      ]
    }
  },
  "models": {
    "large": {
      "provider": "ollama-private",
      "model": "gemma4:26b",
      "max_tokens": 8192
    },
    "small": {
      "provider": "ollama-private",
      "model": "gemma4:e4b",
      "max_tokens": 4096
    }
  },
  "options": {
    "disabled_skills": [
      "crush-config"
    ],
    "skills_paths": [
      "~/.agents/skills"
    ]
  },
  "lsp": {
    "go": {
      "command": "gopls"
    },
    "rust": {
      "command": "rust-analyzer"
    }
  }
}
