{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "disabled_skills": [
      "crush-config"
    ],
    "skills_paths": [
      "~/.config/nvim/crush/skills"
    ]
  },
  "models": {
    "large": {
      "model": "gemini-3-flash-preview",
      "provider": "gemini",
      "reasoning_effort": "minimal",
      "max_tokens": 50000
    }
  },
  "think": false,
  "recent_models": {
    "large": [
      {
        "model": "gemini-3-flash-preview",
        "provider": "gemini"
      }
    ]
  },
  "lsp": {
    "go": {
      "command": "gopls"
    },
    "rust": {
      "command": "rust-analyzer"
    }
  }
}
